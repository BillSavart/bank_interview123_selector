FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS deps
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
  && npm rebuild better-sqlite3 --build-from-source --nodedir=/usr/local \
  && node -e "const Database = require('better-sqlite3'); new Database(':memory:').close()"

FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc
WORKDIR /app
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=32
COPY --from=deps /app/node_modules/better-sqlite3/package.json ./node_modules/better-sqlite3/package.json
COPY --from=deps /app/node_modules/better-sqlite3/lib ./node_modules/better-sqlite3/lib
COPY --from=deps /app/node_modules/better-sqlite3/build/Release/better_sqlite3.node ./node_modules/better-sqlite3/build/Release/better_sqlite3.node
COPY --from=deps /app/node_modules/bindings ./node_modules/bindings
COPY --from=deps /app/node_modules/file-uri-to-path ./node_modules/file-uri-to-path
COPY server/package.json server/ratings-api.mjs server/db.mjs server/official-doc.mjs server/submission-email.mjs server/turnstile.mjs server/admin-session.mjs server/rate-limit.mjs server/voter-session.mjs server/game-rounds.mjs server/migrate-to-sqlite.mjs server/backup-db.mjs ./server/
COPY package.json ./
COPY src/data/checkGame.json src/data/checkGame.ts src/data/numberGame.ts ./src/data/
COPY src/lib/chineseNumerals.ts ./src/lib/
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && rm -rf /var/lib/apt/lists/* \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && mkdir -p /data \
  && chown node:node /data
USER node
EXPOSE 3000
CMD ["node", "server/ratings-api.mjs"]
