# Caddy config for the bank-interview site on a GCP e2-micro VM.
#
# Replace YOUR_DOMAIN below. Caddy auto-provisions + renews HTTPS (Let's Encrypt).
# When Cloudflare sits in front in "Full" mode, this still works:
# Cloudflare → VM:443 (TLS terminated again at Caddy).
#
# Install Caddy:  https://caddyserver.com/docs/install  (apt repo)
# Then:           sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

(public_security_headers) {
	header {
		Strict-Transport-Security "max-age=15552000"
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(admin_security_headers) {
	header {
		Strict-Transport-Security "max-age=15552000"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag "noindex, nofollow"
	}
}

YOUR_DOMAIN {
	encode zstd gzip
	import public_security_headers

	@private path /api/admin /api/admin/* /admin.html
	handle @private {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Bank-Client-IP {http.request.client_ip}
		}
	}

	# 經驗分享文章短網址 /e/<slug> → API 302 轉到 /experience/<id>。
	handle /e/* {
		reverse_proxy 127.0.0.1:3000
	}

	# 經驗分享文章的動態 SEO：搜尋、AdSense 與社群預覽爬蟲會被導到 API，
	# 取得相同文章的標題、canonical 與可直接閱讀的正文；一般使用者走 SPA。
	@articlebot {
		path /experience/*
		header_regexp User-Agent (?i)(googlebot|mediapartners-google|google-display-ads-bot|bingbot|duckduckbot|baiduspider|yandex|facebookexternalhit|facebot|twitterbot|linebot|line/|slackbot|telegram|whatsapp|discordbot|applebot|pinterest|redditbot|embedly|skypeuripreview|w3c_validator)
	}
	handle @articlebot {
		reverse_proxy 127.0.0.1:3000
	}

	# Known public pages have a generated dist/<route>/index.html containing a
	# crawlable HTML fallback. Restricting the matcher prevents arbitrary paths
	# from returning a 200 homepage shell (soft 404).
	@publicpage path / /interview-guide /interview-guide/ /methodology /methodology/ /selector /selector/ /calendar /calendar/ /scores-map /scores-map/ /venues /venues/ /official-doc-practice /official-doc-practice/ /experience /experience/ /salary /salary/ /number-trainer /number-trainer/ /check-game /check-game/ /about /about/ /privacy /privacy/ /terms /terms/ /disclaimer /disclaimer/
	handle @publicpage {
		root * /var/www/bank-interview
		try_files {path} {path}/index.html /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# These three direct practice links are real client routes. They intentionally
	# canonicalize to the main practice page until full per-question rendering is
	# added; other IDs fall through to a real 404.
	@officialdocquestion path /official-doc-practice/sign-001 /official-doc-practice/sign-001/ /official-doc-practice/bot-001 /official-doc-practice/bot-001/ /official-doc-practice/bot-002 /official-doc-practice/bot-002/
	handle @officialdocquestion {
		root * /var/www/bank-interview
		try_files /official-doc-practice/index.html
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex, follow"
		file_server
	}

	# Human readers keep the interactive article SPA. Crawler requests matched
	# above go to the API, which returns 404 for unknown/hidden article IDs.
	@experiencepage path /experience/*
	handle @experiencepage {
		root * /var/www/bank-interview
		try_files /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Unknown public paths and files are served without an SPA fallback, so a
	# missing resource receives file_server's real 404 response.
	handle {
		root * /var/www/bank-interview
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

ADMIN_YOUR_DOMAIN {
	encode zstd gzip
	import admin_security_headers

	@adminapi path /api/admin/* /api/health /api/checkgame/leaderboard /api/numbergame/leaderboard
	handle @adminapi {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Bank-Client-IP {http.request.client_ip}
		}
	}

	@adminpage path / /admin.html
	handle @adminpage {
		root * /var/www/bank-interview
		rewrite * /admin.html
		# Cloudflare skips JavaScript injection when the origin sends no-transform.
		header Cache-Control "no-store, no-transform"
		file_server
	}

	handle /assets/* {
		root * /var/www/bank-interview
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /favicon.svg {
		root * /var/www/bank-interview
		file_server
	}

	handle {
		respond 404
	}
}
