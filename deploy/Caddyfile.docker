# Caddyfile baked into the web container.
# DOMAIN is injected via the compose env (e.g. DOMAIN=interview.example.com).
# For local HTTP-only testing, set DOMAIN=:80 (Caddy then serves plain HTTP, no certs).
#
# ADMIN_DOMAIN is the admin subdomain (e.g. admin.interview.example.com). It serves
# the same SPA + API; on this subdomain the site root IS the admin panel. Writes are
# always gated by ADMIN_TOKEN in the API, so the subdomain is just a tidy, separate
# entry point. Defaults to admin.localhost when unset (harmless for local testing).
#
# OPTIONAL extra hardening — HTTP Basic Auth at the edge: uncomment the basic_auth
# block below and set ADMIN_BASIC_HASH to a bcrypt hash from `caddy hash-password`.

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=15552000"

	# Serve the Cloudflare Origin Certificate (mounted at /certs) instead of
	# provisioning Let's Encrypt. This removes the ACME inbound dependency, so
	# the GCP firewall can be locked to Cloudflare's IP ranges only. Pair with
	# Cloudflare SSL/TLS mode "Full (strict)".
	# NOTE: incompatible with DOMAIN=:80 plain-HTTP local testing — comment this
	# line out (or use the host deploy/Caddyfile) for that.
	tls /certs/origin.pem /certs/origin.key

	handle /api/* {
		reverse_proxy api:3000
	}

	# 經驗分享文章短網址 /e/<slug> → API 302 轉到 /experience/<id>。
	handle /e/* {
		reverse_proxy api:3000
	}

	# 經驗分享文章的動態 SEO：搜尋、AdSense 與社群預覽爬蟲會被導到 API，
	# 取得相同文章的標題、canonical 與可直接閱讀的正文；一般使用者走 SPA。
	@articlebot {
		path /experience/*
		header_regexp User-Agent (?i)(googlebot|mediapartners-google|google-display-ads-bot|bingbot|duckduckbot|baiduspider|yandex|facebookexternalhit|facebot|twitterbot|linebot|line/|slackbot|telegram|whatsapp|discordbot|applebot|pinterest|redditbot|embedly|skypeuripreview|w3c_validator)
	}
	handle @articlebot {
		reverse_proxy api:3000
	}

	# Known public pages have a generated dist/<route>/index.html containing a
	# crawlable HTML fallback. Restricting the matcher prevents arbitrary paths
	# from returning a 200 homepage shell (soft 404).
	@publicpage path / /selector /selector/ /calendar /calendar/ /scores-map /scores-map/ /venues /venues/ /official-doc-practice /official-doc-practice/ /experience /experience/ /salary /salary/ /number-trainer /number-trainer/ /check-game /check-game/ /about /about/ /privacy /privacy/ /terms /terms/ /disclaimer /disclaimer/
	handle @publicpage {
		root * /srv
		try_files {path} {path}/index.html /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# These three direct practice links are real client routes. They intentionally
	# canonicalize to the main practice page until full per-question rendering is
	# added; other IDs fall through to a real 404.
	@officialdocquestion path /official-doc-practice/sign-001 /official-doc-practice/sign-001/ /official-doc-practice/bot-001 /official-doc-practice/bot-001/ /official-doc-practice/bot-002 /official-doc-practice/bot-002/
	handle @officialdocquestion {
		root * /srv
		try_files /official-doc-practice/index.html
		header Cache-Control "no-cache"
		header X-Robots-Tag "noindex, follow"
		file_server
	}

	# Human readers keep the interactive article SPA. Crawler requests matched
	# above go to the API, which returns 404 for unknown/hidden article IDs.
	@experiencepage path /experience/*
	handle @experiencepage {
		root * /srv
		try_files /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Unknown public paths and files are served without an SPA fallback, so a
	# missing resource receives file_server's real 404 response.
	handle {
		root * /srv
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

{$ADMIN_DOMAIN:admin.localhost} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=15552000"

	# Same Cloudflare Origin Certificate as the main site (it covers the apex +
	# a wildcard, or add the admin host when generating it). See note above.
	tls /certs/origin.pem /certs/origin.key

	# Optional edge auth — uncomment to require a browser login on top of the
	# in-app ADMIN_TOKEN. Generate the hash with: caddy hash-password
	# basic_auth {
	# 	admin {$ADMIN_BASIC_HASH}
	# }

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path /index.html /
	header @html Cache-Control "no-cache"
}
