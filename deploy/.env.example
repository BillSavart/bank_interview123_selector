# Docker images and public hosts
REGISTRY=ghcr.io/your-github-username
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
SITE_BASE=https://example.com

# Admin API secret. Generate with: openssl rand -hex 24
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional Caddy basic_auth hash. Leave empty when edge basic auth is disabled.
ADMIN_BASIC_HASH=

# SQLite production backend. Enable only after following deploy/SQLITE-CUTOVER.md.
USE_SQLITE=

# Optional submission Email notification. All three values are required to enable it.
# Prefer a verified sending subdomain so the root domain's email policy stays isolated.
RESEND_API_KEY=re_xxxxxxxxx
SUBMISSION_NOTIFY_EMAIL=owner@example.com
SUBMISSION_EMAIL_FROM="Bank Interview Site <notifications@send.example.com>"

# Cloudflare Turnstile bot protection for public posts and comments.
# Create one Managed widget and allow the root + www hostnames. Both keys are
# required in production; the site key is public, the secret must never be committed.
TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...
TURNSTILE_EXPECTED_HOSTNAMES=example.com,www.example.com
TURNSTILE_TIMEOUT_MS=5000
